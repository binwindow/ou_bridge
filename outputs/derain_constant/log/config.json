{
  "exp_name": "derain_constant",
  "sde": {
    "lambda_square": 30.0,
    "T": 100,
    "schedule": "constant",
    "eps": 0.005
  },
  "network": {
    "architecture": "ConditionalUNet",
    "in_nc": 3,
    "out_nc": 3,
    "nf": 64,
    "depth": 4
  },
  "train": {
    "total_iterations": 200000,
    "batch_size": 8,
    "patch_size": 64,
    "lr": 0.0001,
    "min_lr": 1e-06,
    "optimizer": "AdamW",
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.99,
    "ema_beta": 0.999,
    "ema_update_every": 1,
    "gpu": "5",
    "use_amp": true,
    "use_ddp": false,
    "seed": 42,
    "num_val": 15,
    "log_every": 100,
    "loss_type": "l1"
  },
  "data": {
    "dataset": "default",
    "data_root": "source/DeRain-H",
    "num_workers": 4,
    "use_flip": true,
    "use_rot": true
  },
  "output_root": "outputs"
}